---
import BaseLayout from '@/layouts/BaseLayout.astro';

const title = 'Page Not Found (404) | ChapterBind';
const description = 'The requested page could not be found. Return to the ChapterBind HTML to EPUB Converter or browse our guides.';
---

<BaseLayout title={title} description={description} noindex={true}>
  <section class="mx-auto max-w-2xl px-4 py-16 text-center sm:px-6">
    <div class="rounded-2xl border border-black/10 bg-white p-8 shadow-xs">
      <div class="text-xs font-bold tracking-wider text-[#0a84ff] uppercase">404 Error</div>
      <h1 class="display-heading mt-2 text-3xl font-extrabold text-[#1d1d1f]">Page Not Found</h1>
      <p class="mt-3 text-sm text-[#515154]">
        The page you requested does not exist or has moved.
      </p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <a
          href="/"
          class="btn-tactile rounded-xl bg-[#0a84ff] px-4 py-2 text-xs font-semibold text-white hover:bg-[#0070e0]"
        >
          Open HTML to EPUB Converter
        </a>
        <a
          href="/how-to-convert-html-to-epub/"
          class="btn-tactile rounded-xl border border-black/15 bg-white px-4 py-2 text-xs font-semibold text-[#1d1d1f] hover:bg-[#f5f5f7]"
        >
          Read How-To Guide
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
