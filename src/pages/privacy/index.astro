---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/config/site';

const title = 'Privacy Policy – In-Browser HTML to EPUB Processing | ChapterBind';
const description =
  'Learn how ChapterBind processes HTML files and images locally in your browser without file uploads, user accounts, or server storage.';
---

<BaseLayout title={title} description={description} canonicalPath="/privacy/">
  <article class="mx-auto max-w-3xl px-4 py-8 sm:px-6 sm:py-12">
    <div class="rounded-2xl border border-black/10 bg-white p-6 shadow-xs sm:p-8">
      <h1 class="display-heading text-3xl font-extrabold text-[#1d1d1f]">Privacy Policy</h1>
      <p class="mt-3 text-sm leading-relaxed text-[#515154]">
        Last updated: <time datetime={SITE.lastUpdated}>{SITE.lastUpdated}</time>
      </p>

      <div class="mt-6 space-y-5 text-sm leading-relaxed text-[#515154]">
        <section>
          <h2 class="text-lg font-bold text-[#1d1d1f]">In-Browser File Processing</h2>
          <p class="mt-1.5">
            ChapterBind runs HTML parsing, sanitization, image matching, and EPUB 3 ZIP creation directly inside your browser using JavaScript. Your uploaded HTML documents, local images, book metadata, and generated EPUB files are never sent to an external conversion server.
          </p>
        </section>

        <section>
          <h2 class="text-lg font-bold text-[#1d1d1f]">No Accounts or Cloud Document Storage</h2>
          <p class="mt-1.5">
            You do not need an account to convert files. Workspace state lives in your browser tab memory and clears when you refresh or click <strong>Clear All</strong>.
          </p>
        </section>

        <section>
          <h2 class="text-lg font-bold text-[#1d1d1f]">How Untrusted HTML Is Handled</h2>
          <p class="mt-1.5">
            Imported HTML is parsed offline with DOMPurify and stripped of scripts, event handlers, forms, iframes, and unsafe URLs before rendering inside a sandboxed preview frame (<code>&lt;iframe sandbox=""&gt;</code>) or writing EPUB XHTML files. Remote image and stylesheet URLs inside imported HTML are blocked rather than fetched.
          </p>
        </section>

        <section>
          <h2 class="text-lg font-bold text-[#1d1d1f]">Static Hosting Logs</h2>
          <p class="mt-1.5">
            This site is served as static files via Cloudflare Pages. Standard HTTP access logs handled by the hosting provider record page requests (such as visiting <code>/</code>) and never receive the contents of local files you select in the converter.
          </p>
        </section>

        <section>
          <h2 class="text-lg font-bold text-[#1d1d1f]">Contact</h2>
          <p class="mt-1.5">
            Questions about this privacy policy can be sent to{' '}
            <a href={`mailto:${SITE.contactEmail}`} class="font-semibold text-[#0a84ff] hover:underline">
              {SITE.contactEmail}
            </a>.
          </p>
        </section>
      </div>
    </div>
  </article>
</BaseLayout>
