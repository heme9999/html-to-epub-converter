---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/config/site';

const title = 'Contact ChapterBind – Bug Reports & EPUB Feedback | ChapterBind';
const description =
  'Contact ChapterBind to report HTML to EPUB conversion edge cases, reader rendering bugs, or missing feature requests.';
---

<BaseLayout title={title} description={description} canonicalPath="/contact/">
  <article class="mx-auto max-w-3xl px-4 py-8 sm:px-6 sm:py-12">
    <div class="rounded-2xl border border-black/10 bg-white p-6 shadow-xs sm:p-8">
      <h1 class="display-heading text-3xl font-extrabold text-[#1d1d1f]">Contact ChapterBind</h1>
      <p class="mt-3 text-sm leading-relaxed text-[#515154]">
        Encountered an HTML structure that didn’t convert cleanly, an EPUBCheck warning on a specific input, or a compatibility issue on your e-reader? Let us know so we can reproduce and fix it.
      </p>

      <div class="mt-6 rounded-xl border border-black/10 bg-[#f5f5f7] p-5">
        <div class="text-xs font-bold tracking-wide text-[#515154] uppercase">Direct Email</div>
        <a
          href={`mailto:${SITE.contactEmail}?subject=ChapterBind%20HTML%20to%20EPUB%20Feedback`}
          class="mt-1 inline-block text-base font-bold text-[#0a84ff] hover:underline"
        >
          {SITE.contactEmail}
        </a>
        <p class="mt-2 text-xs leading-relaxed text-[#515154]">
          When reporting a conversion bug, please mention your target e-reader (Apple Books, Kindle, Kobo, Calibre) and any diagnostic warning code shown in the converter.
        </p>
      </div>

      <div class="mt-6 flex flex-wrap gap-3 text-xs">
        <a href="/" class="font-semibold text-[#0a84ff] hover:underline">← Back to Converter</a>
        <span class="text-[#6e6e73]">·</span>
        <a href="/html-to-epub-troubleshooting/" class="font-semibold text-[#0a84ff] hover:underline">
          Troubleshooting Guide
        </a>
      </div>
    </div>
  </article>
</BaseLayout>
